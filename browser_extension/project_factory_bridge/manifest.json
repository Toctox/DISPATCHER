{
  "manifest_version": 3,
  "name": "PROJECT FACTORY BRIDGE",
  "version": "0.2.0",
  "description": "Four mechanical ChatGPT UI operations for the local PROJECT FACTORY dispatcher.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "service_worker.js", "type": "module"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["selectors.js", "composer.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*"
  }
}
