{
  "manifest_version": 3,
  "name": "ChatGPT Local Agent Loop",
  "version": "0.1.0",
  "description": "Dedicated ChatGPT tab ↔ localhost Factory Local Agent execution loop.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Local Agent Loop",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:18765"
  }
}
